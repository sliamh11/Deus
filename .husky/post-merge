node scripts/migrate.mjs --quiet

# Mark the claude-context index as stale after each merge.
# On-demand reindex only — run 'node scripts/claude-context-reindex.mjs' to refresh.
mkdir -p "$HOME/.deus"
echo "$(git rev-parse HEAD) $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$HOME/.deus/index_stale.flag"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Rebuild and restart if source files changed
if git diff-tree --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qE '^(src/|container/)'; then
  "$REPO_ROOT/deus-cmd.sh" build --quiet >> "$HOME/.deus/build.log" 2>&1 &
  disown
fi

